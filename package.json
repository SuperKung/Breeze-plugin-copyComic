{
  "name": "breeze-plugin-copy-comic",
  "version": "0.0.10",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "build": "pnpm typecheck && node --import tsx build/generate-version.ts && node --import tsx build/generate-manifest.ts && cross-env NODE_OPTIONS=\"--import tsx\" rspack build && node --import tsx build/generate-brotli.ts",
    "dev": "pnpm dev:serve",
    "dev:serve": "tsx dev-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@types/node": "^26.1.2",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "ky": "^2.0.2",
    "oxc-parser": "^0.143.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "breeze-plugin-kit": "^0.5.0"
  }
}
